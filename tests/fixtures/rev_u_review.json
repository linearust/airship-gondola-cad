  "direct_drive_review": {
    "servo_mount": "One integral fixed frame includes open-sided vertical servo uprights and both output-bearing supports. A ratio/model change replaces the complete frame.",
    "coupling": "Bought KST0415.13 horn, two-piece printed adapter/retainer and one M2x8 clamp per servo; no printed spline, auxiliary input axle or input bearing.",
